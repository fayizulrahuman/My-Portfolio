# ==============================================================================
# Portfolio Environment Variables
# Copy to `.env` for local development (never commit `.env`),
# and add these same variables in Vercel Dashboard -> Project -> Settings -> Environment Variables.
# ==============================================================================

# Public GitHub username (fetches public created repositories via GitHub REST API)
GITHUB_USERNAME=fayizulrahuman

# Optional GitHub Personal Access Token (recommended for Vercel production)
# Raises GitHub REST API rate limit from 60 req/hr to 5,000 req/hr on shared serverless IPs.
# Server-side only — never exposed to the browser.
GITHUB_TOKEN=

# EmailJS Configuration (https://www.emailjs.com/)
# Add these values in `.env` locally and in Vercel Environment Variables.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Recommended for production: EmailJS Private Key (Access Token) from Account -> Security.
# When set, all EmailJS calls stay 100% server-side so even your Service/Template/Public IDs
# never leave the server. Make sure "Allow EmailJS API for non-browser applications" is enabled.
EMAILJS_PRIVATE_KEY=

# Recipient email used in EmailJS template payload
CONTACT_RECIPIENT_EMAIL=fayizulrahuman2005@gmail.com

# Optional secret required to call POST /api/refresh locally via Authorization: Bearer <REFRESH_SECRET>
REFRESH_SECRET=
