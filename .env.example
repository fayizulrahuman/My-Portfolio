# GitHub username (fetches public created repositories via unauthenticated GitHub REST API)
GITHUB_USERNAME=fayizulrahuman

# EmailJS credentials for the Contact Card (https://www.emailjs.com/)
# Only these 3 values are required — add your real values to a local .env file (never commit .env)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Optional: only needed if you want strictly server-to-server delivery without browser fallback
EMAILJS_PRIVATE_KEY=
